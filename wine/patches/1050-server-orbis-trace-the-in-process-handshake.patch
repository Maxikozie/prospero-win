From: prospero-win orbis <noreply@localhost>
Subject: server, ntdll: orbis: trace the in-process handshake and choose the event loop

On the PS4 the first client never received its request descriptor: ntdll
printed the connect-time lines and then waited in wine_server_receive_fd
with nothing said by either side for ten console runs. Diagnostic lines on
stderr, Orbis only, cover each step: the event loop the server took and
its first wake-ups (which descriptors the kernel reported), the client
socket sent and received on the channel, the process and first thread
created, the request pipe and the first descriptors sent, and on the
client side the socket, the fchdir back and the wait for the request fd.

WINE_ORBIS_POLL=1 leaves the kqueue closed so the main loop polls the
descriptor array instead: whether the PS4's kqueue reports an AF_UNIX
socket pair is a run-time question, and one build answers it both ways
through /data/ps4-wine/env.txt.

To remove once the handshake is seen to complete.

diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index c5b76c7ffd..757eb8e355 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1973,7 +1973,15 @@ static int server_connect(void)
 #ifdef WINE_INPROCESS_SERVER
     /* no socket file and no server process: ask the in-process server */
     s = connect_inprocess_server();
+#ifdef __ORBIS__
+    {
+        int rc = fchdir( initial_cwd );  /* switch back to the starting directory */
+        fprintf( stderr, "wine-orbis: client socket %d, fchdir(%d) -> %d (errno %d)\n",
+                 s, initial_cwd, rc, rc == -1 ? errno : 0 );
+    }
+#else
     fchdir( initial_cwd );  /* switch back to the starting directory */
+#endif
     fcntl( s, F_SETFD, FD_CLOEXEC );
     return s;
 #endif
@@ -2223,7 +2231,13 @@ size_t server_init_process(void)
     pthread_sigmask( SIG_BLOCK, &server_block_set, NULL );
 
     /* receive the first thread request fd on the main socket */
+#ifdef __ORBIS__
+    fprintf( stderr, "wine-orbis: waiting for the request fd on socket %d\n", fd_socket );
+#endif
     data->request_fd = wine_server_receive_fd( &version );
+#ifdef __ORBIS__
+    fprintf( stderr, "wine-orbis: request fd %d, protocol %u\n", data->request_fd, version );
+#endif
 
 #ifdef SO_PASSCRED
     /* now that we hopefully received the server_pid, disable SO_PASSCRED */
diff --git a/server/fd.c b/server/fd.c
index 0c77f4b364..595c7296d2 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -532,6 +532,20 @@ static inline void fd_poll_event( struct fd *fd, int event )
     else default_poll_event( fd, event );
 }
 
+#ifdef __ORBIS__
+/* The first wake-ups of the main loop, on stderr: whether the loop runs at
+ * all and whether the kernel reports the master socket (the in-process
+ * client handshake stalled on the PS4 with nothing said by either side). */
+#define ORBIS_TRACE_WAKES 6
+static unsigned int orbis_wakes;
+static void orbis_trace_wake( const char *call, int ret, int err )
+{
+    if (orbis_wakes++ >= ORBIS_TRACE_WAKES) return;
+    fprintf( stderr, "wineserver: orbis: %s -> %d (errno %d), %d poll users\n",
+             call, ret, ret == -1 ? err : 0, nb_users );
+}
+#endif
+
 #ifdef USE_EPOLL
 
 static int epoll_fd = -1;
@@ -664,7 +678,17 @@ static int kqueue_fd = -1;
 
 static inline void init_epoll(void)
 {
+#ifdef __ORBIS__
+    /* WINE_ORBIS_POLL=1 leaves the queue closed: the main loop then polls
+     * the descriptor array, the path every kernel has. Which filters the
+     * PS4's kqueue answers is a run-time question; one build tries both. */
+    if (getenv( "WINE_ORBIS_POLL" )) kqueue_fd = -1;
+    else kqueue_fd = kqueue();
+    fprintf( stderr, "wineserver: orbis: event loop %s (kqueue fd %d, errno %d)\n",
+             kqueue_fd == -1 ? "poll" : "kqueue", kqueue_fd, kqueue_fd == -1 ? errno : 0 );
+#else
     kqueue_fd = kqueue();
+#endif
 }
 
 static inline void set_fd_epoll_events( struct fd *fd, int user, int events )
@@ -726,6 +750,9 @@ static inline void main_loop_epoll(void)
     struct kevent events[128];
 
     if (kqueue_fd == -1) return;
+#ifdef __ORBIS__
+    fprintf( stderr, "wineserver: orbis: kqueue loop, %d poll users\n", nb_users );
+#endif
 #ifdef WINE_INPROCESS_SERVER
     __atomic_store_n( &inprocess_direct_ok, 1, __ATOMIC_RELEASE );
 #endif
@@ -744,6 +771,14 @@ static inline void main_loop_epoll(void)
         epoch = inprocess_sleep( timeout, &ts );
 #endif
         ret = kevent( kqueue_fd, NULL, 0, events, ARRAY_SIZE( events ), timeout == -1 ? NULL : &ts );
+#ifdef __ORBIS__
+        orbis_trace_wake( "kevent", ret, errno );
+        if (orbis_wakes <= ORBIS_TRACE_WAKES)
+            for (i = 0; i < ret; i++)
+                fprintf( stderr, "wineserver: orbis:   event ident %lu filter %d flags %#x data %ld user %ld\n",
+                         (unsigned long)events[i].ident, (int)events[i].filter, (unsigned int)events[i].flags,
+                         (long)events[i].data, (long)events[i].udata );
+#endif
 
 #ifdef WINE_INPROCESS_SERVER
         if (!inprocess_wake( epoch ))
@@ -1044,6 +1079,9 @@ void main_loop(void)
 
     main_loop_epoll();
     /* fall through to normal poll loop */
+#ifdef __ORBIS__
+    fprintf( stderr, "wineserver: orbis: poll loop, %d poll users\n", nb_users );
+#endif
 #ifdef WINE_INPROCESS_SERVER
     /* poll() reads the poll arrays while it sleeps: clients must not change them */
     __atomic_store_n( &inprocess_direct_ok, 0, __ATOMIC_RELEASE );
@@ -1061,6 +1099,13 @@ void main_loop(void)
         pthread_mutex_unlock( &inprocess_server_mutex );
 #endif
         ret = poll( pollfd, nb_users, timeout );
+#ifdef __ORBIS__
+        orbis_trace_wake( "poll", ret, errno );
+        if (orbis_wakes <= ORBIS_TRACE_WAKES)
+            for (i = 0; i < nb_users; i++)
+                if (pollfd[i].revents)
+                    fprintf( stderr, "wineserver: orbis:   user %d fd %d revents %#x\n", i, pollfd[i].fd, pollfd[i].revents );
+#endif
 #ifdef WINE_INPROCESS_SERVER
         pthread_mutex_lock( &inprocess_server_mutex );
 #endif
diff --git a/server/request.c b/server/request.c
index 0f1626f55e..a396b9ef21 100644
--- a/server/request.c
+++ b/server/request.c
@@ -746,6 +746,10 @@ int receive_fd( struct process *process )
 }
 
 /* send an fd to a client */
+#ifdef __ORBIS__
+static unsigned int orbis_fds_sent;
+#endif
+
 int send_client_fd( struct process *process, int fd, obj_handle_t handle )
 {
     struct iovec vec;
@@ -776,6 +780,13 @@ int send_client_fd( struct process *process, int fd, obj_handle_t handle )
         fprintf( stderr, "%04x: *fd* %04x -> %d\n", current ? current->id : process->id, handle, fd );
 
     ret = sendmsg( get_unix_fd( process->msg_fd ), &msghdr, 0 );
+#ifdef __ORBIS__
+    if (ret != sizeof(handle))
+        fprintf( stderr, "wineserver: orbis: sendmsg of fd %d to process %04x -> %d (errno %d)\n",
+                 fd, process->id, ret, ret == -1 ? errno : 0 );
+    else if (orbis_fds_sent++ < 2)
+        fprintf( stderr, "wineserver: orbis: fd %d sent to process %04x as %04x\n", fd, process->id, handle );
+#endif
 
     if (ret == sizeof(handle)) return 0;
 
@@ -860,13 +871,32 @@ static int receive_inprocess_client( int channel )
     msg.msg_iovlen = 1;
     msg.msg_control = &control;
     msg.msg_controllen = sizeof(control);
+#ifdef __ORBIS__
+    {
+        ssize_t got = recvmsg( channel, &msg, 0 );
+        if (got != 1)
+        {
+            fprintf( stderr, "wineserver: orbis: recvmsg on the client channel %d -> %d (errno %d)\n",
+                     channel, (int)got, got == -1 ? errno : 0 );
+            return -1;
+        }
+    }
+#else
     if (recvmsg( channel, &msg, 0 ) != 1) return -1;
+#endif
     for (cmsg = CMSG_FIRSTHDR( &msg ); cmsg; cmsg = CMSG_NXTHDR( &msg, cmsg ))
     {
         if (cmsg->cmsg_level != SOL_SOCKET || cmsg->cmsg_type != SCM_RIGHTS) continue;
         memcpy( &fd, CMSG_DATA( cmsg ), sizeof(fd) );
+#ifdef __ORBIS__
+        fprintf( stderr, "wineserver: orbis: client socket %d received\n", fd );
+#endif
         return fd;
     }
+#ifdef __ORBIS__
+    fprintf( stderr, "wineserver: orbis: client message without a descriptor (controllen %u, flags %#x)\n",
+             (unsigned int)msg.msg_controllen, (unsigned int)msg.msg_flags );
+#endif
     return -1;
 }
 
@@ -897,11 +927,19 @@ int connect_inprocess_client(void)
     memcpy( CMSG_DATA( cmsg ), &pair[0], sizeof(int) );
     if (sendmsg( client_channel, &msg, 0 ) != 1)
     {
+#ifdef __ORBIS__
+        fprintf( stderr, "wineserver: orbis: sendmsg on the client channel %d failed (errno %d)\n",
+                 client_channel, errno );
+#endif
         close( pair[0] );
         close( pair[1] );
         return -1;
     }
     close( pair[0] );
+#ifdef __ORBIS__
+    fprintf( stderr, "wineserver: orbis: client socket %d sent on channel %d, keeping %d\n",
+             pair[0], client_channel, pair[1] );
+#endif
     return pair[1];
 }
 #endif
@@ -936,8 +974,15 @@ static void master_socket_poll_event( struct fd *fd, int event )
         {
             struct thread *thread = create_thread( -1, process, NULL );
             if (thread) add_process_thread( process, thread );
+#ifdef __ORBIS__
+            fprintf( stderr, "wineserver: orbis: process %04x created, first thread %s (status %08x)\n",
+                     process->id, thread ? "created" : "failed", get_error() );
+#endif
             release_object( process );
         }
+#ifdef __ORBIS__
+        else fprintf( stderr, "wineserver: orbis: create_process failed (status %08x)\n", get_error() );
+#endif
     }
 }
 
