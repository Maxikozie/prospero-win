From: prospero-win orbis <noreply@localhost>
Subject: server: orbis: go on when O_NONBLOCK is refused on a client's descriptor

Measured on the PS4 (console run 12): fcntl(F_SETFL, O_NONBLOCK) on the
reply descriptor a client passed with SCM_RIGHTS fails with EACCES, and
init_thread then gave up without a reply, which the client waits for
forever. wine/orbis/pw_wine_compat_orbis.c now tries FIONBIO behind a
refused F_SETFL; should that be refused as well, the thread keeps a
blocking reply descriptor (64-byte replies to a client that reads them at
once) instead of dying, and the two other unchecked O_NONBLOCK calls of
the in-process server (the accepted client socket, the wake pipe) report
a refusal.

diff --git a/server/request.c b/server/request.c
index 97bbabc618..23f3571735 100644
--- a/server/request.c
+++ b/server/request.c
@@ -990,7 +990,12 @@ static void master_socket_poll_event( struct fd *fd, int event )
         int client = accept( get_unix_fd( master_socket->fd ), (struct sockaddr *) &dummy, &len );
 #endif
         if (client == -1) return;
+#ifdef __ORBIS__
+        if (fcntl( client, F_SETFL, O_NONBLOCK ) == -1)
+            fprintf( stderr, "wineserver: orbis: O_NONBLOCK on client socket %d refused (errno %d)\n", client, errno );
+#else
         fcntl( client, F_SETFL, O_NONBLOCK );
+#endif
         if ((process = create_process( client, NULL, 0, NULL, NULL, NULL, 0, NULL )))
         {
             struct thread *thread = create_thread( -1, process, NULL );
@@ -1324,8 +1329,14 @@ void open_master_socket(void)
             if (pipe( wake ) == -1) fatal_error( "pipe: %s\n", strerror( errno ));
             fcntl( wake[0], F_SETFD, FD_CLOEXEC );
             fcntl( wake[1], F_SETFD, FD_CLOEXEC );
+#ifdef __ORBIS__
+            if (fcntl( wake[0], F_SETFL, O_NONBLOCK ) == -1 || fcntl( wake[1], F_SETFL, O_NONBLOCK ) == -1)
+                fprintf( stderr, "wineserver: orbis: O_NONBLOCK on the wake pipe %d/%d refused (errno %d): a wake would block the loop\n",
+                         wake[0], wake[1], errno );
+#else
             fcntl( wake[0], F_SETFL, O_NONBLOCK );
             fcntl( wake[1], F_SETFL, O_NONBLOCK );
+#endif
             if (!(wake_fd = create_anonymous_fd( &inprocess_wake_fd_ops, wake[0], &master_socket->obj, 0 )))
                 fatal_error( "out of memory\n" );
             set_fd_events( wake_fd, POLLIN );
diff --git a/server/thread.c b/server/thread.c
index 6b131e4854..4f97c11ff8 100644
--- a/server/thread.c
+++ b/server/thread.c
@@ -1893,9 +1893,15 @@ static int init_thread( struct thread *thread, int reply_fd, int wait_fd )
     if (fcntl( reply_fd, F_SETFL, O_NONBLOCK ) == -1)
     {
 #ifdef __ORBIS__
-        fprintf( stderr, "wineserver: orbis: init_thread %04x: O_NONBLOCK on reply fd %d refused (errno %d)\n", thread->id, reply_fd, errno );
-#endif
+        /* Measured on the PS4 (run 12): EACCES on a passed socket pair end.
+         * The compat fcntl wrap tries FIONBIO first; when that is refused
+         * too, a blocking reply descriptor still carries 64-byte replies to
+         * a client that reads them at once, so the thread goes on. */
+        fprintf( stderr, "wineserver: orbis: init_thread %04x: O_NONBLOCK on reply fd %d refused (errno %d), going on blocking\n",
+                 thread->id, reply_fd, errno );
+#else
         goto error;
+#endif
     }
 
     thread->reply_fd = create_anonymous_fd( &thread_fd_ops, reply_fd, &thread->obj, 0 );
