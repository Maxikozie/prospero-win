From: prospero-win orbis <noreply@localhost>
Subject: server: orbis: report a failed startup mapping instead of faulting on it

On the PS4 create_user_data_mapping returned NULL during init_directories
(measured: SIGSEGV in release_object), with nothing said about why. The
three startup mappings are checked and a failure is reported with the
server status and errno; the server goes on without it.

diff --git a/server/directory.c b/server/directory.c
index 2b9d03edc0..07f997fa18 100644
--- a/server/directory.c
+++ b/server/directory.c
@@ -20,6 +20,7 @@
  */
 
 #include "config.h"
+#include <errno.h>
 
 #include <assert.h>
 #include <stdarg.h>
@@ -476,12 +477,28 @@ void init_directories( struct fd *intl_fd )
     release_object( create_keyed_event( &dir_kernel->obj, keyed_event_crit_sect_str, OBJ_PERMANENT, NULL ));
 
     /* mappings */
+#ifdef __ORBIS__
+    /* On the PS4 a startup mapping can fail (measured: the user shared data
+     * mapping came back NULL); say which and why instead of faulting on it. */
+    {
+        struct object *obj;
+        if ((obj = (struct object *)create_fd_mapping( &dir_nls->obj, intl_str, intl_fd, OBJ_PERMANENT, NULL ))) release_object( obj );
+        else fprintf( stderr, "wineserver: orbis: nls mapping failed, status %08x errno %d\n", get_error(), errno );
+        if ((obj = create_user_data_mapping( &dir_kernel->obj, user_data_str, OBJ_PERMANENT, NULL ))) release_object( obj );
+        else fprintf( stderr, "wineserver: orbis: user shared data mapping failed, status %08x errno %d\n", get_error(), errno );
+        release_object( intl_fd );
+        session_mapping = create_session_mapping( &dir_kernel->obj, session_str, OBJ_PERMANENT, NULL );
+        if (!session_mapping) fprintf( stderr, "wineserver: orbis: session mapping failed, status %08x errno %d\n", get_error(), errno );
+        else set_session_mapping( session_mapping );
+    }
+#else
     release_object( create_fd_mapping( &dir_nls->obj, intl_str, intl_fd, OBJ_PERMANENT, NULL ));
     release_object( create_user_data_mapping( &dir_kernel->obj, user_data_str, OBJ_PERMANENT, NULL ));
     release_object( intl_fd );
 
     session_mapping = create_session_mapping( &dir_kernel->obj, session_str, OBJ_PERMANENT, NULL );
     set_session_mapping( session_mapping );
+#endif
     release_object( session_mapping );
 
     atom_table = create_atom_table();
