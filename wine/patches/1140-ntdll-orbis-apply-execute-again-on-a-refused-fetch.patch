From: prospero-win orbis <noreply@localhost>
Subject: ntdll: orbis: apply execute again when a fetch faults on an executable page

On the PS4 a 32-bit program fixed at 0x400000 (the PS4 port's milestone i,
fixed32.exe) faulted on its first call through an import thunk: an
instruction fetch on the 16 KiB host page its .text shares with .data. The
host calls for its image were all accepted (mprotect of that host page to
RWX returned 0, traced through WINE_PS5_TRACE_PROT), and Wine's own view of
the page allowed execute, so virtual_handle_fault took the fault for a real
one. The same calls replayed by a probe in one thread, with the code written
while the page was read-write, then RWX, ran the code from 64-bit and 32-bit
mode.

On the PS4 only: when an instruction fetch faults on a page whose protection
and whose host page's both have execute, apply the host page's protection
again (past the record of what it is) and let the instruction run again, at
most three times for a page, each logged with ERR. The log says whether the
second application is what the page needed.
---
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 2c4158234a..14e2c1f7f4 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -5259,6 +5259,44 @@ static char *subpage_hot_write( char *page )
 /***********************************************************************
  *           virtual_handle_fault
  */
+#ifdef __ORBIS__
+/***********************************************************************
+ *           orbis_exec_refault
+ *
+ * An instruction fetch faulted on a page that Wine made executable (the page's
+ * protection and its host page's both have execute). On the PS4 a direct-memory
+ * page whose contents were written while it was not executable has faulted so
+ * after its protection was changed to include execute (ps4-wine LOG L18, L20;
+ * the same calls replayed in one thread ran, L21). Apply the host page's
+ * protection again, past the record of what it is, and let the instruction run
+ * again: at most three times for a page, each logged.
+ */
+static BOOL orbis_exec_refault( char *page )
+{
+    static struct { char *page; unsigned int tries; } seen[32];
+    static unsigned int next;
+    unsigned int i;
+    int prot, rc;
+
+    for (i = 0; i < ARRAY_SIZE(seen); i++) if (seen[i].page == page) break;
+    if (i == ARRAY_SIZE(seen))
+    {
+        i = next++ % ARRAY_SIZE(seen);
+        seen[i].page = page;
+        seen[i].tries = 0;
+    }
+    if (seen[i].tries >= 3) return FALSE;
+    seen[i].tries++;
+    prot = get_host_page_unix_prot( page, NULL, NULL, 0, 0 );
+    host_prot_record( page, host_page_size, 0 );
+    rc = host_mprotect( page, host_page_size, prot );
+    if (!rc) host_prot_record( page, host_page_size, prot | HOST_PROT_KNOWN );
+    ERR( "execute fault on %p, which has execute: protection %#x applied again (try %u) rc=%d\n",
+         page, prot, seen[i].tries, rc );
+    return !rc;
+}
+#endif
+
 NTSTATUS virtual_handle_fault( struct thread_data *data, EXCEPTION_RECORD *rec, void *stack )
 {
     NTSTATUS ret = STATUS_ACCESS_VIOLATION;
@@ -5316,6 +5354,13 @@ NTSTATUS virtual_handle_fault( struct thread_data *data, EXCEPTION_RECORD *rec,
                 ret = STATUS_SUCCESS;
         }
     }
+#ifdef __ORBIS__
+    if (ret == STATUS_ACCESS_VIOLATION && err == EXCEPTION_EXECUTE_FAULT &&
+        (get_unix_prot( get_page_vprot( addr ) ) & PROT_EXEC) &&
+        (get_host_page_unix_prot( page, NULL, NULL, 0, 0 ) & PROT_EXEC) &&
+        orbis_exec_refault( page ))
+        ret = STATUS_SUCCESS;
+#endif
     if (ret == STATUS_ACCESS_VIOLATION && host_page_size != page_size && !data->subpage_step)
     {
