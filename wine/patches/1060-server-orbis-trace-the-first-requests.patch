+            if ((ret = send_request( data->request_fd, req ))) return ret;
+            ret = wait_reply( data->reply_fd, req );
+            fprintf( stderr, "wine-orbis: request %d -> status %08x\n", (int)req->u.req.request_header.req, ret );
+            return ret;
+        }
+    }
 #endif
     if ((ret = send_request( data->request_fd, req ))) return ret;
     ret = wait_reply( data->reply_fd, req );
